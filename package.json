{
  "name": "@local/dsh-countdown-days",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Countdown days for the DeepSeek Harness Web UI: birthdays, anniversaries, loan and credit-card due dates, with Chinese lunar calendar, recurrence and reminders.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Veagau/dsh-countdown-days.git"
  },
  "bugs": { "url": "https://github.com/Veagau/dsh-countdown-days/issues" },
  "homepage": "https://github.com/Veagau/dsh-countdown-days#readme",
  "keywords": ["deepseek-harness", "dsh", "plugin", "countdown", "lunar-calendar", "reminders"],
  "scripts": { "check": "node scripts/check.mjs", "test": "node scripts/lunar-test.mjs && node scripts/storage-test.mjs && node scripts/settings-test.mjs" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
